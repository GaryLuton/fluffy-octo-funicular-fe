# Anthropic API key (required) - your Claude API key
ANTHROPIC_API_KEY=sk-ant-xxxxx

# JWT secret for auth tokens (required in production - use a random string)
JWT_SECRET=change-me-to-a-random-secret

# Port (Railway sets this automatically)
PORT=3000

# Database path (optional - defaults to ./stuflover.db)
# DATABASE_PATH=./stuflover.db

# Allowed CORS origins (comma-separated, optional - allows all if not set)
# ALLOWED_ORIGINS=https://stuflover.vercel.app,https://yourdomain.com

# Resend API key (required for password reset emails)
RESEND_API_KEY=re_xxxxx

# From address for password reset emails (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Admin dashboard credentials (required for /admin.html access)
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-secure-admin-password

# Printify storefront (/shopp) - leave blank to serve a demo catalog
# Create a token at https://printify.com/app/account/api
PRINTIFY_API_TOKEN=
# Your Printify shop ID (GET https://api.printify.com/v1/shops.json)
PRINTIFY_SHOP_ID=
# Optional shared secret to authenticate Printify's publish webhook
PRINTIFY_WEBHOOK_KEY=
# Set to "true" once you're ready for real fulfillment: paid Printify orders are
# sent to production (charged + printed) automatically. Leave blank/false to
# create orders on-hold so you can review them in the Printify dashboard first.
PRINTIFY_AUTO_PRODUCTION=

# Stripe payments (Shop + Printify checkout). Leave blank to use mock checkout.
# Secret key from https://dashboard.stripe.com/apikeys (sk_test_… or sk_live_…)
STRIPE_SECRET_KEY=
# Signing secret of your Stripe webhook endpoint (whsec_…) — point the endpoint
# at https://your-domain/api/shop/webhook (handles both Shop and Printify orders)
STRIPE_WEBHOOK_SECRET=
# Currency the store prices and charges in (e.g. GBP, USD)
STORE_CURRENCY=GBP
# Public base URL used for Stripe success/cancel redirects
PUBLIC_BASE_URL=https://stuflover.com
